{
  "manifest_version": 3,
  "name": "Highlighty",
  "version": "1.0.0",
  "description": "Highlight text with a draggable, rotatable, paginated colour toolbar.",
  "permissions": ["storage", "contextMenus", "activeTab"],
  "background": {
  "service_worker": "background.js",
  "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*", "file:///*"],
      "js": ["picker.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Highlighty — show toolbar"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "commands": {
    "highlight-selection": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Highlight the selected text"
    }
  }
}
